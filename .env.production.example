# =============================================================
# CAVRIX CLOUD - PRODUCTION ENVIRONMENT
# This file is auto-generated by ./install.sh. Do not commit a
# real .env to git. Copy to .env and fill real values, or run:
#   ./install.sh --domain your.domain --email you@mail.com
# =============================================================

# --- App ---
APP_ENV=production
DB_AUTO_CREATE=false
MOCK_PROVIDER_ENABLED=false
SECURE_COOKIES=true
CAVRIX_DOMAIN=change-me.example.com
CORS_ORIGINS=https://change-me.example.com
FRONTEND_URL=https://change-me.example.com
PUBLIC_BASE_URL=https://change-me.example.com

# --- Security (MUST be generated; install.sh does this automatically) ---
# python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-secret
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key-here

# --- Postgres (used by docker-compose.prod.yml) ---
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Admin bootstrap (created on first startup) ---
SEED_ADMIN_EMAIL=admin@cavrix.cloud
SEED_ADMIN_PASSWORD=ChangeMe!12345

# --- Cloudflare (optional but recommended for custom domain + auto TLS) ---
# Token must have Zone.DNS:Edit permission on the zone. Zone id is auto-detected.
CLOUDFLARE_DNS_API_TOKEN=

# --- Let's Encrypt account email ---
ACME_EMAIL=
