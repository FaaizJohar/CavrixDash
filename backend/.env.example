# ============================================================
# CAVRIX CLOUD - BACKEND ENVIRONMENT
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# --- App ---
APP_NAME=Cavrix Cloud
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=UTC
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Comma-separated extra CORS origins (frontend URL is added automatically)
CORS_ORIGINS=http://localhost:5173

# --- Security ---
# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Startup FAILS in production if these keep their insecure defaults.
SECRET_KEY=change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_VERSION=1
SECURE_COOKIES=false
# Encrypt provider credentials at rest. Required in production. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# --- Database (PostgreSQL for production) ---
DATABASE_URL=postgresql+psycopg://cavrix:cavrix@localhost:5432/cavrix
# For quick local dev without Postgres you may use:
# DATABASE_URL=sqlite+pysqlite:///./cavrix.db
DB_AUTO_CREATE=true

# --- Redis (rate limiting, caching, pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_POSTBACK_PER_MIN=300

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cavrix.cloud
SMTP_TLS=true
EMAIL_VERIFICATION_REQUIRED=false

# --- Pterodactyl defaults (can be overridden in Admin panel) ---
PTERODACTYL_PANEL_URL=
PTERODACTYL_API_KEY=

# --- Provider defaults (can be overridden in Admin panel) ---
CPALEAD_API_KEY=
CPALEAD_SECRET_KEY=
ADGEM_API_KEY=
SHRINKME_API_KEY=

# --- Rewards / CVX defaults (overridable in admin) ---
CVX_NAME=CVX
CVX_SYMBOL=CVX
CVX_GLOBAL_MULTIPLIER=1.0
CVX_MAX_BALANCE=100000
CVX_DAILY_LIMIT=5000
CVX_HOURLY_LIMIT=1000

# --- Server defaults ---
SERVERS_MAX_PER_USER=3
SERVERS_DEFAULT_DURATION_DAYS=30
SERVERS_MIN_CVX=2500

# --- Referral ---
REFERRAL_ENABLED=true
REFERRAL_REWARD=250
REFERRAL_VERIFICATION_REQUIRED=true

# --- Mock/dev provider ---
# Development-only fixture. Disabled by default (production safe).
# Set true ONLY in dev/staging with mock offers intent.
MOCK_PROVIDER_ENABLED=false

# --- Admin bootstrap (used by seed script) ---
# Required in production; startup FAILS if the default admin password is kept.
SEED_ADMIN_EMAIL=admin@cavrix.cloud
SEED_ADMIN_PASSWORD=ChangeMe!12345

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
